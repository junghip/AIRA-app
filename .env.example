# 이 파일을 .env.local 로 복사하고 값을 채우면 포토부스 사진·방명록이 인터넷(Supabase)에 저장됩니다.
# 비워 두면 "테스트 모드" — 같은 브라우저에서만 열려요.
# Supabase 대시보드 → Project Settings → API 에서 복사
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# QR에 넣을 주소 (로컬에서 테스트할 때도 QR이 배포 주소로 가게 하려면)
# VITE_PUBLIC_URL=https://junghip.github.io/AIRA-app
